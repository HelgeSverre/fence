{
  "name": "fence",
  "version": "0.1.0",
  "description": "Split-view markdown editor built with Elm and Electron",
  "author": {
    "name": "Helge Sverre",
    "email": "helge.sverre@gmail.com",
    "url": "https://helgesver.re"
  },
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "dev:debug": "concurrently \"vite\" \"wait-on http://localhost:5173 && DEVTOOLS=1 electron .\"",
    "build": "vite build && electron-builder",
    "build:mac": "vite build && electron-builder --mac",
    "build:win": "vite build && electron-builder --win",
    "build:linux": "vite build && electron-builder --linux",
    "vite:dev": "vite"
  },
  "build": {
    "appId": "no.helgesverre.fence",
    "productName": "Fence",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "build/icons/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "identity": "Developer ID Application",
      "notarize": true
    },
    "win": {
      "icon": "build/icons/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "icon": "build/icons/icon.png",
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false
    },
    "publish": {
      "provider": "github",
      "owner": "HelgeSverre",
      "repo": "fence"
    }
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "electron": "^41.0.0",
    "electron-builder": "^26.8.1",
    "elm": "^0.19.1-6",
    "vite": "^5.4.21",
    "vite-plugin-elm": "^3.0.1",
    "wait-on": "^7.2.0"
  },
  "dependencies": {
    "chokidar": "^3.6.0",
    "electron-updater": "^6.8.3",
    "mermaid": "^11.13.0"
  }
}
