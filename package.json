{
  "name": "fence",
  "version": "0.1.3",
  "description": "Split-view markdown editor built with Elm and Electron",
  "packageManager": "bun@1.3.14",
  "trustedDependencies": [
    "electron",
    "electron-winstaller",
    "elm",
    "esbuild"
  ],
  "author": {
    "name": "Helge Sverre",
    "email": "helge.sverre@gmail.com",
    "url": "https://helgesver.re"
  },
  "homepage": "https://github.com/HelgeSverre/fence",
  "repository": {
    "type": "git",
    "url": "https://github.com/HelgeSverre/fence.git"
  },
  "bugs": "https://github.com/HelgeSverre/fence/issues",
  "license": "MIT",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "dev:debug": "DEVTOOLS=1 vite",
    "test": "bun run test:elm && bun run test:node",
    "test:elm": "elm-test --compiler node_modules/.bin/elm",
    "test:node": "node --test electron/*.test.js",
    "test:e2e": "node --test --test-concurrency=1 e2e/*.test.js",
    "build": "vite build && electron-builder",
    "build:mac": "vite build && electron-builder --mac",
    "build:win": "vite build && electron-builder --win",
    "build:linux": "vite build && electron-builder --linux"
  },
  "build": {
    "appId": "no.helgesverre.fence",
    "productName": "Fence",
    "copyright": "Copyright © 2026 Helge Sverre",
    "fileAssociations": [
      {
        "ext": ["md", "markdown", "mdown", "mkd"],
        "name": "Markdown Document",
        "description": "Markdown Document",
        "mimeType": "text/markdown",
        "role": "Editor",
        "rank": "Alternate"
      }
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "build/icons/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "identity": "Developer ID Application",
      "notarize": true
    },
    "win": {
      "icon": "build/icons/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "icon": "build/icons/icon.png",
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development;TextEditor",
      "maintainer": "Helge Sverre <helge.sverre@gmail.com>",
      "synopsis": "Split-view Markdown editor",
      "mimeTypes": ["text/markdown"],
      "desktop": {
        "entry": {
          "Comment": "Split-view Markdown editor with live preview",
          "Keywords": "markdown;editor;notes;"
        }
      }
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false
    },
    "publish": {
      "provider": "github",
      "owner": "HelgeSverre",
      "repo": "fence"
    }
  },
  "devDependencies": {
    "electron": "^44.1.0",
    "electron-builder": "^26.15.3",
    "elm": "^0.19.2-0",
    "elm-test": "^0.19.2-1",
    "esbuild": "^0.28.2",
    "playwright": "^1.62.1",
    "vite": "^8.2.2",
    "vite-plugin-electron": "^1.1.2",
    "vite-plugin-elm": "^3.0.1"
  },
  "dependencies": {
    "chokidar": "^4.0.3",
    "electron-updater": "^6.8.9",
    "mermaid": "^11.17.2"
  },
  "patchedDependencies": {
    "vite-plugin-elm@3.0.1": "patches/vite-plugin-elm@3.0.1.patch"
  }
}
